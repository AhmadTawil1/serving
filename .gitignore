# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

.claude

# Regenerable build artifacts
.cache/
.pytest_cache/

# Engine builds are large binary artifacts, architecture-specific, and
# persisted to Drive per M03-SERVING.md §5 -- never committed here. Only the
# build log (wall time, RAM, VRAM, outcome) is checked in.
engines/

# Served-model weight caches, if downloaded into the repo tree by mistake.
data/hf_cache/

# ---------------------------------------------------------------------
# Working notes, kept private. The repository publishes the measurement,
# the code that produced it, and the paper -- not the daily process
# documents behind them.
# ---------------------------------------------------------------------
LOG.md
SCOPE.md
REFERENCE.md
M03-SERVING.md
PAPER.md
paper/PAPER-framework-draft-superseded.md

# LaTeX build artifacts. main.pdf IS committed (it is the deliverable);
# everything else regenerates from main.tex. refs.bib is emitted by the
# filecontents block inside main.tex, so it is generated too.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/refs.bib
